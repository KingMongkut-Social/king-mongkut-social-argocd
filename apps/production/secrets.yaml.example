apiVersion: v1
kind: Secret
metadata:
  name: king-mongkut-social-backend-secret
  namespace: king-mongkut-social-production
  labels:
    app.kubernetes.io/name: king-mongkut-social-backend-secret
    app.kubernetes.io/part-of: king-mongkut-social
type: Opaque
stringData:
  MONGODB_URI: "mongodb://king_user:change_me_to_strong_password@mongodb:27017/king_mongkut_social?authSource=admin"
  ACCESS_TOKEN_SECRET: "king_mongkut_social_prod_access_secret_32chars_min_example"
  REFRESH_TOKEN_SECRET: "king_mongkut_social_prod_refresh_secret_32chars_min_example"
  GOOGLE_CLIENT_ID: "your-google-oauth-client-id.apps.googleusercontent.com"
  GOOGLE_CLIENT_SECRET: "your-google-oauth-client-secret"
---
apiVersion: v1
kind: Secret
metadata:
  name: king-mongkut-social-infra-secret
  namespace: king-mongkut-social-production
  labels:
    app.kubernetes.io/name: king-mongkut-social-infra-secret
    app.kubernetes.io/part-of: king-mongkut-social
type: Opaque
stringData:
  MONGO_INITDB_ROOT_USERNAME: "king_user"
  MONGO_INITDB_ROOT_PASSWORD: "change_me_to_strong_password"
---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: king-mongkut-social-production
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "ey...example_base64_encoded_dockerconfigjson...=="
